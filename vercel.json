{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci --prefix backend && npm ci --include=dev --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "api/index.js": {
      "includeFiles": "frontend/dist/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/broadcasts", "schedule": "*/1 * * * *" }
  ]
}
